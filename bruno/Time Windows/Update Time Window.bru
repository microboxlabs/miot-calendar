meta {
  name: Update Time Window
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/miot-calendar/calendars/{{calendarId}}/time-windows/{{timeWindowId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Morning Shift",
    "startHour": 8,
    "endHour": 16,
    "slotDurationMinutes": 30,
    "capacityPerSlot": 5,
    "daysOfWeek": "MON,TUE,WED,THU,FRI",
    "validFrom": "2025-01-01",
    "active": true
  }
}
